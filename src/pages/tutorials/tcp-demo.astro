---
import CourseLayout from "../../layouts/CourseLayout.astro";

const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const series = home + "tutorials/tcp-demo/";
---

<CourseLayout
  page="tcp-demo"
  title="TCP demo tutorials | Computer Networks"
  description="Choose a TCP tutorial for one laptop, a phone hotspot, Docker, a client dashboard, or a private server."
>
  <div class="intro lab-intro">
    <h1>
      TCP demo <span>tutorials</span>
    </h1>
    <p>
      Run a transfer, explain what happened, then try the same exchange on a
      different network.
    </p>
  </div>

  <section class="lab-section" aria-labelledby="choose-demo">
    <h2 id="choose-demo">Choose a tutorial</h2>
    <ol class="lab-steps">
      <li id="loopback">
        <a href={series + "loopback/"}>
          <strong>Rehearse on one laptop</strong>
        </a>
        <p>
          Send HELLO over loopback, check the hashes, and prepare a two-minute
          demo with an offline fallback.
        </p>
      </li>
      <li id="hotspot-docker">
        <a href={series + "hotspot/"}>
          <strong>Connect two laptops on a phone hotspot</strong>
        </a>
        <p>
          Find the server laptop’s IP and troubleshoot a refused or missing
          connection.
        </p>
      </li>
      <li>
        <a href={series + "docker/"}>
          <strong>Connect two Docker containers</strong>
        </a>
        <p>
          Run the same client and server on a bridge network and connect by
          service name.
        </p>
      </li>
      <li id="client-dashboard">
        <a href={series + "client-dashboard/"}>
          <strong>Plan a client and dashboard</strong>
        </a>
        <p>
          Use a file picker to start the transfer and decide what to show in the
          activity view.
        </p>
      </li>
      <li id="private-server">
        <a href={series + "private-server/"}>
          <strong>Try a private remote server</strong>
        </a>
        <p>
          Reach a server over a private network and verify the saved file on a
          second machine.
        </p>
      </li>
    </ol>
    <div class="lesson-next">
      <div>
        <h3>See the packets in Wireshark</h3>
        <p>Use a practice capture or collect your own loopback traffic.</p>
      </div>
      <a class="button" href={home + "labs/wireshark/"}>
        Read a TCP capture
      </a>
      <a class="button" href={home + "labs/wireshark/udp/"}>
        Read a UDP capture
      </a>
    </div>
  </section>
</CourseLayout>
