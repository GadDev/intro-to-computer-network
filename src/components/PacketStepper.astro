---
import type { PacketStep } from "./packet-lessons";

interface Props {
  label: string;
  steps: PacketStep[];
  sender?: string;
  receiver?: string;
}

const { label, steps, sender = "Sender", receiver = "Receiver" } = Astro.props;
---

<packet-stepper
  role="group"
  aria-label={label}
  data-steps={JSON.stringify(steps)}
>
  <div class="interactive" data-interactive hidden>
    <div class="packet-stage" aria-hidden="true">
      <div class="endpoints">
        <span>{sender}</span>
        <span>{receiver}</span>
      </div>
      <div class="track">
        <span class="packet" data-packet></span>
      </div>
    </div>
    <div class="controls" role="group" aria-label="Animation controls">
      <button type="button" class="primary" data-next>
        Next step
      </button>
      <button type="button" data-prev>
        Previous
      </button>
      <button type="button" data-play>
        Play
      </button>
      <button type="button" data-reset>
        Reset
      </button>
    </div>
    <div class="step-copy" role="status" aria-atomic="true">
      <div class="step-caption">
        <p class="step-index" data-step-index></p>
        <h4 data-title></h4>
        <p data-detail></p>
      </div>
      <div class="receiver-status">
        <p>
          <strong>{receiver}</strong> <span data-receiver></span>
        </p>
        {steps[0].fileSlots && (
          <ul class="file-slots" aria-label="Receiver’s file">
            {steps[0].fileSlots.map((_, position) => (
              <li data-slot={position}></li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>

  <details open>
    <summary>Read the full sequence</summary>
    <ol class="transcript">
      {steps.map(({ title, detail }) => (
        <li>
          <strong>{title}.</strong> {detail}
        </li>
      ))}
    </ol>
  </details>
</packet-stepper>

<script>
  import type { PacketStep } from "./packet-lessons";

  class PacketStepper extends HTMLElement {
    #cleanup?: () => void;

    connectedCallback() {
      const steps: PacketStep[] = JSON.parse(this.dataset.steps!);
      const interactive =
        this.querySelector<HTMLElement>("[data-interactive]")!;
      const packet = this.querySelector<HTMLElement>("[data-packet]")!;
      const index = this.querySelector<HTMLElement>("[data-step-index]")!;
      const title = this.querySelector<HTMLElement>("[data-title]")!;
      const detail = this.querySelector<HTMLElement>("[data-detail]")!;
      const receiver = this.querySelector<HTMLElement>("[data-receiver]")!;
      const slots = this.querySelectorAll<HTMLElement>("[data-slot]");
      const previous = this.querySelector<HTMLButtonElement>("[data-prev]")!;
      const next = this.querySelector<HTMLButtonElement>("[data-next]")!;
      const play = this.querySelector<HTMLButtonElement>("[data-play]")!;
      const reset = this.querySelector<HTMLButtonElement>("[data-reset]")!;
      const transcript = this.querySelector<HTMLDetailsElement>("details")!;
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const listeners = new AbortController();
      const options = { signal: listeners.signal };
      const last = steps.length - 1;

      let step = 0;
      let timer: number | undefined;
      let movement: Animation | undefined;

      function stop() {
        window.clearInterval(timer);
        timer = undefined;
        play.textContent = "Play";
      }

      function show(animate = false) {
        const event = steps[step];
        movement?.cancel();
        movement = undefined;
        packet.dataset.tone = event.tone;
        packet.textContent = event.label;
        packet.style.left = `${event.to}%`;
        if (
          animate &&
          !reducedMotion.matches &&
          event.from !== event.to &&
          packet.animate
        ) {
          movement = packet.animate(
            [{ left: `${event.from}%` }, { left: `${event.to}%` }],
            { duration: 500, easing: "cubic-bezier(.2,.8,.2,1)" },
          );
        }

        receiver.textContent = event.receiver;
        slots.forEach((slot, position) => {
          const filled = event.fileSlots?.[position];
          slot.dataset.filled = String(Boolean(filled));
          slot.textContent = `#${position + 1} · ${filled ? "Received" : "Empty"}`;
        });
        index.textContent = `Step ${step + 1} of ${steps.length}`;
        title.textContent = event.title;
        detail.textContent = event.detail;
        // Keep focus on the active button when the learner reaches either end.
        previous.setAttribute("aria-disabled", String(step === 0));
        next.setAttribute("aria-disabled", String(step === last));
      }

      function advance() {
        step += 1;
        show(true);
        if (step === last) stop();
      }

      previous.addEventListener(
        "click",
        () => {
          if (step === 0) return;
          stop();
          step -= 1;
          show();
        },
        options,
      );
      next.addEventListener(
        "click",
        () => {
          if (step === last) return;
          stop();
          advance();
        },
        options,
      );
      reset.addEventListener(
        "click",
        () => {
          stop();
          step = 0;
          show();
        },
        options,
      );
      play.addEventListener(
        "click",
        () => {
          if (timer !== undefined) {
            stop();
            movement?.pause();
            return;
          }

          if (step === last) {
            step = 0;
            show();
          } else if (movement?.playState === "paused") {
            movement.play();
          }
          play.textContent = "Pause";
          timer = window.setInterval(advance, 3500);
        },
        options,
      );
      reducedMotion.addEventListener(
        "change",
        () => {
          if (reducedMotion.matches) movement?.cancel();
        },
        options,
      );

      show();
      interactive.hidden = false;
      transcript.open = false;
      this.#cleanup = () => {
        stop();
        movement?.cancel();
        listeners.abort();
      };
    }

    disconnectedCallback() {
      this.#cleanup?.();
    }
  }

  customElements.define("packet-stepper", PacketStepper);
</script>
