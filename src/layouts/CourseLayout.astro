---
import "../styles/course.css";
import "@fontsource/barlow-condensed/latin-900.css";
import "../styles/editorial.css";

interface Props {
  title: string;
  description: string;
  page: "course" | "wireshark" | "tcp-file-transfer";
}

const { title, description, page } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const course = page === "course" ? "" : home;
const lab = `${home}labs/wireshark/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9ff" />
    <script is:inline>
      (() => {
        const storageKey = "course-theme";
        const root = document.documentElement;
        const themeColor = document.querySelector('meta[name="theme-color"]');

        function readPreference() {
          try {
            const saved = localStorage.getItem(storageKey);
            return saved === "dark" || saved === "light" ? saved : null;
          } catch {
            return null;
          }
        }

        function applyTheme(theme) {
          const dark = theme === "dark";
          root.dataset.theme = theme;
          themeColor.content = dark ? "#000000" : "#faf9ff";
          document
            .getElementById("theme-toggle")
            ?.setAttribute("aria-pressed", String(dark));
        }

        applyTheme(readPreference() ?? "light");

        document.addEventListener("DOMContentLoaded", () => {
          const toggle = document.getElementById("theme-toggle");
          toggle.setAttribute(
            "aria-pressed",
            String(root.dataset.theme === "dark"),
          );
          toggle.addEventListener("click", () => {
            const theme = root.dataset.theme === "dark" ? "light" : "dark";
            applyTheme(theme);
            try {
              localStorage.setItem(storageKey, theme);
            } catch {
              // The switch still works when storage is disabled.
            }
          });
          toggle.hidden = false;
        });

        window.addEventListener("pageshow", ({ persisted }) => {
          if (!persisted) return;
          const saved = readPreference();
          if (saved) applyTheme(saved);
        });
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#top">
      Skip to content
    </a>
    <header class="site-header">
      <div class="wrap header-inner">
        <div class="header-brand">
          <a class="wordmark" href={page === "course" ? "#top" : home}>
            Computer Networks
          </a>
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-pressed="false"
            hidden
          >
            Dark mode
          </button>
        </div>
        <nav aria-label="Course">
          <a href={`${course}#tcp`}>TCP</a>
          <a href={`${course}#udp`}>UDP</a>
          <a
            href={`${home}labs/tcp-file-transfer/`}
            aria-current={page === "tcp-file-transfer" ? "page" : undefined}
          >
            Python lab
          </a>
          <a
            href={lab}
            aria-current={page === "wireshark" ? "page" : undefined}
          >
            Wireshark lab
          </a>
          <a href={`${course}#assignment`}>Assignment</a>
          <a href={`${course}#glossary`}>Glossary</a>
        </nav>
      </div>
    </header>

    <main
      id="top"
      class={page === "course" ? "course-shell" : "wrap lab-shell"}
      tabindex="-1"
    >
      <slot />
    </main>

    <footer class="wrap site-footer">
      <nav aria-label="Course resources">
        <a href={`${course}#assignment`}>Assignment</a>
        <a href={`${course}#glossary`}>Glossary</a>
        <a href="https://github.com/GadDev/binfo-networks-final-project">
          Coursework code and results
        </a>
      </nav>
      <nav aria-label="Protocol references">
        <a href="https://www.rfc-editor.org/rfc/rfc9293.html">
          TCP specification
        </a>
        <a href="https://www.rfc-editor.org/rfc/rfc768.html">
          UDP specification
        </a>
      </nav>
    </footer>
  </body>
</html>
