---
import "../styles/course.css";

interface Props {
  title: string;
  description: string;
  page: "course" | "wireshark";
}

const { title, description, page } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const course = page === "course" ? "" : home;
const lab = `${home}labs/wireshark/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href={page === "course" ? "#top" : home}>Computer Networks</a>
        <nav aria-label="Course">
          <a href={`${course}#tcp`}>TCP</a>
          <a href={`${course}#udp`}>UDP</a>
          <a href={lab} aria-current={page === "wireshark" ? "page" : undefined}>Wireshark lab</a>
          <a href={`${course}#assignment`}>Assignment</a>
          <a href={`${course}#glossary`}>Glossary</a>
        </nav>
      </div>
    </header>

    <main id="top" class="wrap" tabindex="-1">
      <slot />
    </main>

    <footer class="wrap">
      <a href="https://github.com/GadDev/binfo-networks-final-project">Coursework code and results</a>
      <a href="https://www.rfc-editor.org/rfc/rfc9293.html">TCP specification</a>
      <a href="https://www.rfc-editor.org/rfc/rfc768.html">UDP specification</a>
    </footer>
  </body>
</html>
